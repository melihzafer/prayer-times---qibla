# Prayer Times & Qibla Environment Configuration
# Copy this file to .env.local and fill in the values

# Gemini API Key (BACKEND ONLY - DO NOT EXPOSE TO CLIENT)
# Get your API key from: https://makersuite.google.com/app/apikey
# This should only be used in a backend server, NOT in the client bundle
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Aladhan API base URL (default is public free API)
# ALADHAN_API_URL=https://api.aladhan.com/v1

# Optional: Nominatim API configuration
# NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Feature flags
# ENABLE_NOTIFICATIONS=true
# ENABLE_NEARBY_MOSQUES=true
# ENABLE_AI_FEATURES=true
